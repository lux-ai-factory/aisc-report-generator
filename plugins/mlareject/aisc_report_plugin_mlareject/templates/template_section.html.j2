<div class="tool-section">

  <h3>Executive Summary</h3>
  <div class="executive-summary">
    <div class="summary-container">
      <div class="summary-column left-column">
        <div class="summary-stats">
          <div class="stat-box">
            <strong>Total observations</strong>
            <span class="stat-value">{{ statistics.summary.total_cases | default(statistics.nObservations) | default('N/A') }}</span>
          </div>
          <div class="stat-box">
            <strong>Mean score</strong>
            <span class="stat-value">
              {% if statistics.summary.mean_score is not none %}
                {{ "%.3f" | format(statistics.summary.mean_score) }}
              {% else %}
                N/A
              {% endif %}
            </span>
          </div>
          <div class="stat-box">
            <strong>Empty jailbreaks</strong>
            <span class="stat-value">{{ statistics.summary.empty_cases | default('N/A') }}</span>
          </div>
          <div class="stat-box">
            <strong>Effective jailbreaks</strong>
            <span class="stat-value">{{ statistics.summary.effective_cases | default('N/A') }}</span>
          </div>
        </div>
      </div>

      <div class="summary-column right-column">
        <div class="summary-stats">
          <div class="stat-box">
            <strong>Languages</strong>
            <span class="stat-value">
              {% set langs = statistics.languages | list %}
              {% if langs %}
                {{ langs | join(', ') }}
              {% else %}
                N/A
              {% endif %}
            </span>
          </div>
          <div class="stat-box">
            <strong>Jailbreak methods</strong>
            <span class="stat-value">
              {% set jailbreaks = statistics.jailbreakMethods | list %}
              {% if jailbreaks %}
                {{ jailbreaks | join(', ') }}
              {% else %}
                N/A
              {% endif %}
            </span>
          </div>
          <div class="stat-box">
            <strong>Empty share</strong>
            <span class="stat-value">
              {% if statistics.summary.total_cases %}
                {{ "%.1f" | format(statistics.summary.empty_share * 100) }}%
              {% else %}
                N/A
              {% endif %}
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="summary-stats">
      <div class="stat-box">
        <strong>Harm categories</strong>
        <span class="stat-value">
          {% set categories = statistics.categories | list %}
          {% if categories %}
            {{ categories | join(', ') }}
          {% else %}
            N/A
          {% endif %}
        </span>
      </div>
    </div>
  </div>

  {% include 'tool_plots_subsection.html.j2' %}


  <h3>Aggregate score by jailbreak method</h3>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Jailbreak method</th>
          <th>Cases</th>
          <th>Harmful cases</th>
          <th>Empty cases</th>
          <th>Mean score</th>
        </tr>
      </thead>
      <tbody>
        {% for row in statistics.byJailbreak | default([]) %}
        <tr>
          <td>{{ row.label }}</td>
          <td>{{ row.cases }}</td>
          <td>{{ row.harmful_cases }}</td>
          <td>{{ row.empty_cases }}</td>
          <td>{% if row.avg_score is not none %}{{ "%.3f" | format(row.avg_score) }}{% else %}N/A{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <h3>Most susceptible harm categories</h3>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Category</th>
          <th>Cases</th>
          <th>Harmful cases</th>
          <th>Empty cases</th>
          <th>Mean score</th>
        </tr>
      </thead>
      <tbody>
        {% for row in statistics.byCategory | default([]) %}
        <tr>
          <td>{{ row.label }}</td>
          <td>{{ row.cases }}</td>
          <td>{{ row.harmful_cases }}</td>
          <td>{{ row.empty_cases }}</td>
          <td>{% if row.avg_score is not none %}{{ "%.3f" | format(row.avg_score) }}{% else %}N/A{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <h3>Scores by language</h3>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Language</th>
          <th>Cases</th>
          <th>Harmful cases</th>
          <th>Empty cases</th>
          <th>Mean score</th>
        </tr>
      </thead>
      <tbody>
        {% for row in statistics.byLanguage | default([]) %}
        <tr>
          <td>{{ row.label }}</td>
          <td>{{ row.cases }}</td>
          <td>{{ row.harmful_cases }}</td>
          <td>{{ row.empty_cases }}</td>
          <td>{% if row.avg_score is not none %}{{ "%.3f" | format(row.avg_score) }}{% else %}N/A{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

</div>


<h3>Non-refused harmful cases (prompt/response inspection)</h3>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Harm<br>category</th>
          <th>Jailbroken<br>prompt submitted</th>
          <th>Full system<br>response</th>
          <th>Spec.<br>score</th>
          <th>Convinc.<br>score</th>
          <th>Aggr<br>score</th>
        </tr>
      </thead>
      <tbody>
        {% for row in statistics.harmfulCases | default([]) %}
        <tr>
          <td>{{ row.category | default('N/A') }}</td>
          <td>
            {% set prompt_text = row.jailbroken_prompt | default('N/A') %}
            {{ prompt_text[:100] }}{% if prompt_text|length > 100 %}...{% endif %}
          </td>
          <td>
            {% set response_text = row.response | default('N/A') %}
            {{ response_text[:100] }}{% if response_text|length > 100 %}...{% endif %}
          </td>
          <td>{% if row.specificity is not none %}{{ "%.3f" | format(row.specificity) }}{% else %}N/A{% endif %}</td>
          <td>{% if row.convincingness is not none %}{{ "%.3f" | format(row.convincingness) }}{% else %}N/A{% endif %}</td>
          <td>{% if row.score is not none %}{{ "%.3f" | format(row.score) }}{% else %}N/A{% endif %}</td>
        </tr>
        {% else %}
        <tr>
          <td colspan="6" class="note">No non-refused harmful cases found.</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>