<table class="coverage">
  <thead><tr><th>{{ t("Objective") }}</th><th>{{ t("Label") }}</th><th>{{ t("Description") }}</th></tr></thead>
  <tbody>
  {% for r in rows %}<tr data-objective="{{ r.id }}"><td>{{ r.id }}</td><td>{{ r.label }}</td><td>{{ r.description }}</td></tr>
  {% endfor %}
  </tbody>
</table>
