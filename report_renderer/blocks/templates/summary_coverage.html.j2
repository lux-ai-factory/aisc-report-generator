<table class="coverage">
  <thead><tr><th>{{ t("Objective") }}</th><th>{{ t("Label") }}</th><th>{{ t("Tests") }}</th><th>{{ t("Checklists") }}</th><th>{{ t("Status") }}</th></tr></thead>
  <tbody>
  {% for r in rows %}<tr data-objective="{{ r.id }}"><td>{{ r.id }}</td><td>{{ r.label }}</td><td>{{ r.tests | join(", ") }}</td><td>{{ r.checklists | join(", ") }}</td><td>{{ t(r.status) }}</td></tr>
  {% endfor %}
  </tbody>
</table>
<p class="coverage-counts">{% for st, n in counts %}{{ t("{label}: {value}", label=t(st), value="")|trim }} <span data-coverage-count="{{ st }}">{{ n }}</span>{% if not loop.last %}; {% endif %}{% endfor %}</p>
