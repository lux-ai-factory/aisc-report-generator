<table class="measurements">
  <thead><tr><th>{{ t("Metric") }}</th><th>{{ t("Value") }}</th><th>{{ t("Unit") }}</th></tr></thead>
  <tbody>
  {% for r in rows %}<tr><td>{{ r.metric }}</td><td>{{ r.value }}</td><td>{{ r.unit }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% if more %}<p class="more">{{ t("and {count} more", count=more) }}</p>{% endif %}
